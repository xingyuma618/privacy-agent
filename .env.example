# Copy to .env and load with: set -a; source .env; set +a
OPENAI_API_KEY=EMPTY
SYNTHESIS_API_KEY=EMPTY
SYNTHESIS_BASE_URL=http://127.0.0.1:8039/v1
SYNTHESIS_MODEL_NAME=Qwen3.6-27B
SQL_GENERATE_API_KEY=EMPTY
SQL_GENERATE_BASE_URL=http://127.0.0.1:8039/v1
SQL_GENERATE_MODEL_NAME=Qwen3.6-27B
QUERY_REWRITE_BASE_URL=http://127.0.0.1:8036/v1
QUERY_REWRITE_MODEL_NAME=query_rewrite_v2
ENTITY_EXTRACT_BASE_URL=http://127.0.0.1:8037/v1
ENTITY_EXTRACT_MODEL_NAME=entity_extract_v1
# Set real database/model paths before training or evaluation.
# BIRD_DB_BASE_DIR=/path/to/train_databases
# BASE_MODEL=/path/to/Qwen3-4B-Instruct-2507
# MODEL_PATH=/path/to/agent-cold-start-checkpoint

# RL privacy reward: active by default. Disable only for reward ablation.
PRIVACY_BASE_URL=http://127.0.0.1:8039/v1
PRIVACY_MODEL_NAME=Qwen3.6-27B
PRIVACY_API_KEY=EMPTY
LAMBDA_EXEC=2.0
LAMBDA_PRIV=2.0
ENABLE_PRIVACY_REWARD=1
# BIRD_DEV_DB_BASE_DIR=/path/to/dev_databases
